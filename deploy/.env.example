# Copy to deploy/.env (git-ignored) and fill in. Read by deploy/compose.yaml only.
# Generate secrets in Windows PowerShell 5.1:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)

POSTGRES_USER=docmind
POSTGRES_PASSWORD=
POSTGRES_DB=docmind

DOCMIND_JWT_SECRET_KEY=
DOCMIND_ENVIRONMENT=prod
# Host names the API answers to (Host header). Add your proxy's public name when you have one.
DOCMIND_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to the reverse proxy's address once one is in front (never to 0.0.0.0/0).
DOCMIND_TRUSTED_PROXIES=
DOCMIND_API_PORT=8080

# Generation: disabled (default), fake (not in prod), or openai-compatible.
DOCMIND_GENERATION_BACKEND=disabled
# Containerized Ollama (--profile ollama):
# DOCMIND_GENERATION_BASE_URL=http://ollama:11434/v1
# Ollama running on the Windows host instead (Docker Desktop):
# DOCMIND_GENERATION_BASE_URL=http://host.docker.internal:11434/v1
DOCMIND_GENERATION_MODEL=qwen2.5:3b-instruct
# DOCMIND_GENERATION_TOKENIZER=Qwen/Qwen2.5-3B-Instruct

# The embedding model must be in the hf-cache volume; set both to allow a first download.
DOCMIND_EMBEDDING_ALLOW_DOWNLOAD=false
HF_HUB_OFFLINE=1
