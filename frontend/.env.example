# Copy to .env.local (git-ignored). Read by the Next.js server only: nothing here reaches
# the browser, and the frontend needs no NEXT_PUBLIC_* variables.

# Where the FastAPI backend listens (no trailing slash, no /api/v1).
DOCMIND_API_URL=http://127.0.0.1:8001

# Only when a reverse proxy in front of Next.js OVERWRITES X-Forwarded-For with the real
# client address: forward it to the backend auth endpoints so rate limits are per user
# address (the backend must also list this server in DOCMIND_TRUSTED_PROXIES). Leave it
# false otherwise: a client could send any X-Forwarded-For and dodge the limits.
DOCMIND_BFF_FORWARD_CLIENT_IP=false
