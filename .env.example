# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# --- App (read by app/core/config.py, prefix DOCMIND_) ---
DOCMIND_ENVIRONMENT=dev
DOCMIND_DEBUG=false
DOCMIND_LOG_LEVEL=INFO

# SQLAlchemy URL; the driver must be psycopg 3 ("postgresql+psycopg://").
# User/password/port must match the POSTGRES_* values below.
# Use 127.0.0.1, not localhost: Docker binds IPv4 only, and localhost tries IPv6 (::1) first.
DOCMIND_DATABASE_URL=postgresql+psycopg://docmind:change-me@127.0.0.1:5432/docmind
# Optional tuning (defaults shown):
# DOCMIND_DB_POOL_SIZE=5
# DOCMIND_DB_MAX_OVERFLOW=5
# DOCMIND_DB_POOL_TIMEOUT_S=5
# DOCMIND_DB_CONNECT_TIMEOUT_S=3
# DOCMIND_DB_READINESS_TIMEOUT_MS=2000

# Uploads (defaults shown). Keep the storage directory OUTSIDE the repository.
# Default when unset: <your home>\.docmind\storage
# DOCMIND_STORAGE_DIR=C:\DocMindData\storage
# DOCMIND_MAX_UPLOAD_BYTES=10485760
# DOCMIND_MAX_PDF_PAGES=2000
# DOCMIND_MAX_DOCX_UNCOMPRESSED_BYTES=52428800
# Access tokens (Phase 8). REQUIRED in prod: at least 32 random bytes, kept only here or in
# the environment. Generate one (PowerShell):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
# Unset in dev/test = a random per-process key (tokens stop working on restart).
# DOCMIND_JWT_SECRET_KEY=
# DOCMIND_JWT_ISSUER=docmind
# DOCMIND_JWT_AUDIENCE=docmind-api
# DOCMIND_ACCESS_TOKEN_TTL_MINUTES=15
# Refresh sessions (Phase 9): idle lifetime of a refresh token, absolute session lifetime.
# DOCMIND_REFRESH_TOKEN_TTL_DAYS=7
# DOCMIND_SESSION_MAX_AGE_DAYS=30

# Auth rate limits, "requests/seconds" (Phase 9, defaults shown).
# DOCMIND_RATE_LIMIT_ENABLED=true
# DOCMIND_RATE_LIMIT_LOGIN_PER_IP=20/60
# DOCMIND_RATE_LIMIT_LOGIN_FAILURES_PER_EMAIL=10/900
# DOCMIND_RATE_LIMIT_REGISTER_PER_IP=10/3600
# DOCMIND_RATE_LIMIT_REFRESH_PER_IP=60/60
# Only behind a reverse proxy: its address(es), so X-Forwarded-For is believed.
# DOCMIND_TRUSTED_PROXIES=

# HTTP hardening (Phase 9). DOCMIND_ALLOWED_HOSTS is REQUIRED in prod (no "*").
# DOCMIND_ALLOWED_HOSTS=localhost,127.0.0.1
# DOCMIND_CORS_ALLOWED_ORIGINS=
# DOCMIND_HSTS_ENABLED=false
# Unset = /docs and /openapi.json on, except in prod.
# DOCMIND_DOCS_ENABLED=true

# Logs and worker housekeeping (Phase 9).
# DOCMIND_LOG_FORMAT=json
# DOCMIND_WORKER_HEARTBEAT_FILE=C:\DocMindData\worker-heartbeat
# DOCMIND_MAINTENANCE_INTERVAL_S=3600

# Embeddings and chunking (defaults shown). Install with: pip install -e ".[embeddings]"
# The first worker start downloads the model into the Hugging Face cache.
# DOCMIND_EMBEDDING_BACKEND=sentence-transformers
# DOCMIND_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# DOCMIND_EMBEDDING_DEVICE=cpu
# DOCMIND_EMBEDDING_BATCH_SIZE=32
# DOCMIND_EMBEDDING_CACHE_DIR=C:\DocMindData\hf-cache
# DOCMIND_EMBEDDING_ALLOW_DOWNLOAD=true
# DOCMIND_CHUNK_SIZE_TOKENS=256
# DOCMIND_CHUNK_OVERLAP_TOKENS=32
# DOCMIND_MAX_CHUNKS_PER_DOCUMENT=20000

# Semantic search (default shown): statement_timeout for the vector query.
# DOCMIND_SEARCH_TIMEOUT_MS=5000
# Hybrid search (POST /api/v1/search/hybrid): candidates per branch (1..100) and RRF constant.
# DOCMIND_HYBRID_CANDIDATE_POOL=50
# DOCMIND_HYBRID_RRF_K=60

# Indexing worker (python -m app.worker), defaults shown.
# DOCMIND_WORKER_POLL_INTERVAL_S=2
# DOCMIND_JOB_LEASE_TIMEOUT_S=1800
# DOCMIND_JOB_MAX_ATTEMPTS=3
# DOCMIND_JOB_RETRY_DELAY_S=30

# Question answering (POST /api/v1/ask). Default "disabled": /ask answers 503.
# Local Ollama example, as measured in Phase 7.1 (see README "Local model (Ollama)"):
# DOCMIND_GENERATION_BACKEND=openai-compatible
# DOCMIND_GENERATION_BASE_URL=http://127.0.0.1:11434/v1
# DOCMIND_GENERATION_MODEL=qwen2.5:3b-instruct
# DOCMIND_GENERATION_TOKENIZER=Qwen/Qwen2.5-3B-Instruct
# Must equal the context Ollama loaded the model with (`ollama ps`, column CONTEXT):
# DOCMIND_GENERATION_CONTEXT_WINDOW=4096
# DOCMIND_RAG_CONTEXT_TOKEN_BUDGET=3000
# DOCMIND_RAG_PROMPT_VERSION=grounded-qa-v2
# Phase 7.2 options, all opt-in (defaults reproduce Phase 7.1; see README "Phase 7.2"):
# DOCMIND_RAG_CONTEXT_SELECTION=rank            # or relative_margin
# DOCMIND_RAG_SIMILARITY_MARGIN=0.03
# DOCMIND_RAG_GROUNDING_MODE=legacy             # or verified (model-assisted support check)
# DOCMIND_GENERATION_MAX_ATTEMPTS=1             # 2-3 = retry broken JSON replies
# Only for servers that need a key (hosted APIs). Never commit a real key.
# DOCMIND_GENERATION_API_KEY=

# Integration tests only. Database name MUST end in "_test": its schema is dropped each run.
# Not read by the app; set it in your shell (see README) or keep it here for reference.
# DOCMIND_TEST_DATABASE_URL=postgresql+psycopg://docmind:change-me@127.0.0.1:5432/docmind_test

# --- Docker Compose (read by docker-compose.yml from this same .env file) ---
POSTGRES_USER=docmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docmind
POSTGRES_PORT=5432
